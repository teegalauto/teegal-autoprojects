{
  "name": "teegal",
  "private": true,
  "version": "1.3.67",
  "description": "Teegal Desktop Application",
  "author": "wuchu",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "download:pyodide": "node scripts/download-pyodide.js",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron:build-watch\" \"wait-on http://localhost:8080 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"const fs=require('fs');const d='dist-electron';['main','preload'].forEach(f=>{if(fs.existsSync(d+'/'+f+'.js'))fs.renameSync(d+'/'+f+'.js',d+'/'+f+'.cjs')})\"",
    "electron:build-watch": "tsc -p electron/tsconfig.json --watch",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:package": "npm run build && npm run electron:build && electron-builder",
    "electron:package:win": "npm run backend:build && npm run build && npm run electron:build && node scripts/pre-package-clean.js && electron-builder --win && node scripts/post-package-clean.js && npm run verify:build",
    "verify:build": "node scripts/verify-build.js",
    "electron:package:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "electron:package:linux": "npm run build && npm run electron:build && electron-builder --linux",
    "backend:dev": "cd local-backend && cross-env NODE_ENV=development npx electron-rebuild && cross-env ELECTRON_RUN_AS_NODE=1 electron dist/server.js",
    "backend:build": "cd local-backend && npm run build",
    "rebuild:electron": "cd local-backend/node_modules/better-sqlite3 && npx prebuild-install --runtime=electron --target=40.2.1 --arch=x64 --force"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tanstack/react-query": "^5.56.2",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx-preview": "^0.4.0",
    "dxf-react": "^0.1.0",
    "dxf-render": "^1.7.1",
    "electron-updater": "^6.8.3",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.462.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.12.1",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^5.7.284",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.5.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "react-simple-code-editor": "^0.14.1",
    "react-textarea-autosize": "^8.5.9",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.19.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "ali-oss": "^6.23.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "ico-endec": "^0.1.6",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.teegal.desktop",
    "productName": "Teegal",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/semver/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/sax/**/*",
      "!**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts",
      "!local-backend/**/*"
    ],
    "extraResources": [
      {
        "from": "local-backend/dist",
        "to": "app.asar.unpacked/local-backend/dist",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.ts.map"
        ]
      },
      {
        "from": "local-backend/node_modules",
        "to": "app.asar.unpacked/local-backend/node_modules",
        "filter": [
          "**/*",
          "!**/.cache",
          "!**/.bin",
          "!**/*.map",
          "!**/*.md",
          "!**/*.d.ts",
          "!**/@types/**",
          "!**/typescript/**",
          "!**/ts-node/**",
          "!**/ts-node-dev/**",
          "!**/better-sqlite3/build/Release/obj/**",
          "!**/better-sqlite3/src/**",
          "!**/better-sqlite3/deps/sqlite3/**"
        ]
      },
      {
        "from": "local-backend/.env.encrypted",
        "to": "app.asar.unpacked/local-backend/.env.encrypted"
      },
      {
        "from": "local-backend/package.json",
        "to": "app.asar.unpacked/local-backend/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Teegal",
      "artifactName": "Teegal-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/favicon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/favicon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "generic",
      "url": "https://bb-1storage.oss-cn-hangzhou.aliyuncs.com/updates",
      "channel": "latest"
    }
  }
}
